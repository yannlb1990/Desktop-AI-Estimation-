# Copy this file to .env and fill in real values. Never commit .env to git.

VITE_SUPABASE_URL=your_value_here
# This is the anon/public key, not the service key
VITE_SUPABASE_PUBLISHABLE_KEY=your_value_here

# Get from sentry.io — leave empty in dev to disable error tracking
VITE_SENTRY_DSN=

# Get from posthog.com — leave empty in dev to disable analytics
VITE_POSTHOG_KEY=
# PostHog host
VITE_POSTHOG_HOST=https://app.posthog.com
